<Window x:Class="DevTestEvidenceCapture.App.Views.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/DevTestEvidenceCapture.App;component/Assets/AppIcon.ico"
        Title="Name Your Screenshots" Height="420" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="#" FontWeight="Bold"/>
            <TextBlock Grid.Column="2" Text="Current Filename" FontWeight="Bold"/>
            <TextBlock Grid.Column="3" Text="Meaningful Name (optional)" FontWeight="Bold"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                            <Setter Property="Background" Value="#FFF3CD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="48" Height="48" Cursor="Hand" MouseLeftButtonDown="Thumbnail_Click">
                                    <Border Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="1"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"/>
                                    <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="Gray" FontSize="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding SequenceNumber}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding CurrentFileName}"/>
                                    <TextBlock Text="{Binding Note}" ToolTip="{Binding Note}" Foreground="Gray" FontSize="11"
                                               FontStyle="Italic" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="3" Text="{Binding MeaningfulName, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" Margin="4,2"
                                         TabIndex="{Binding SequenceNumber}"
                                         Loaded="MeaningfulNameTextBox_Loaded"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="DarkRed" TextWrapping="Wrap" Text="{Binding ConflictMessage}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Skip" Padding="12,4" Command="{Binding SkipCommand}"/>
            <Button Content="Confirm" Padding="12,4" Margin="8,0,0,0" Command="{Binding ConfirmCommand}" TabIndex="9000"/>
        </StackPanel>
    </Grid>
</Window>
