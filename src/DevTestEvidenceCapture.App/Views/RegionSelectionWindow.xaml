<Window x:Class="DevTestEvidenceCapture.App.Views.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Capture Area"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Toolbar controls never take keyboard focus, so Enter/Esc/Ctrl+Z always reach the window. -->
        <Style x:Key="ToolButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColorButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="GroupName" Value="ShapeColor"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolbarDividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Fill" Value="#FFBDBDBD"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="Surface" Background="Transparent" Cursor="Cross"
              MouseLeftButtonDown="Surface_MouseLeftButtonDown"
              MouseMove="Surface_MouseMove"
              MouseLeftButtonUp="Surface_MouseLeftButtonUp"
              MouseRightButtonUp="Surface_MouseRightButtonUp">
            <Image x:Name="FrozenScreen" Stretch="Fill"/>
            <Path x:Name="DimOverlay" Fill="#80000000" IsHitTestVisible="False"/>
            <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False"/>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="SelectionBorder" Stroke="#FF0078D4" StrokeThickness="2" Visibility="Collapsed"/>
                <Border x:Name="SizeLabel" Background="#CC000000" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
                    <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"/>
                </Border>
            </Canvas>
            <Border x:Name="HintBanner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0"
                    Background="#E6202020" CornerRadius="4" Padding="14,8" IsHitTestVisible="False">
                <TextBlock Foreground="White" FontSize="14"
                           Text="Drag to select an area   •   Enter: full screen   •   Esc / right-click: cancel"/>
            </Border>
        </Grid>

        <Canvas>
            <Border x:Name="Toolbar" Visibility="Collapsed" Cursor="Arrow"
                    Background="#F5F3F3F3" BorderBrush="#FF8A8A8A" BorderThickness="1" CornerRadius="4" Padding="6">
                <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SelectToolButton" GroupName="Tool" Content="Select area"
                                 Style="{StaticResource ToolButtonStyle}" Checked="ToolButton_Checked"
                                 ToolTip="Drag to redraw the capture area"/>
                    <RadioButton x:Name="HighlighterToolButton" GroupName="Tool" Content="Highlighter"
                                 Style="{StaticResource ToolButtonStyle}" Checked="ToolButton_Checked"
                                 ToolTip="Yellow highlighter"/>
                    <RadioButton x:Name="RectangleToolButton" GroupName="Tool" Content="Rectangle"
                                 Style="{StaticResource ToolButtonStyle}" Checked="ToolButton_Checked"
                                 ToolTip="Hold Shift for a square"/>
                    <RadioButton x:Name="EllipseToolButton" GroupName="Tool" Content="Ellipse"
                                 Style="{StaticResource ToolButtonStyle}" Checked="ToolButton_Checked"
                                 ToolTip="Hold Shift for a circle"/>
                    <RadioButton x:Name="PixelateToolButton" GroupName="Tool" Content="Pixelate"
                                 Style="{StaticResource ToolButtonStyle}" Checked="ToolButton_Checked"
                                 ToolTip="Obscure sensitive data such as patient details"/>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <StackPanel x:Name="SizeOptions" Orientation="Horizontal">
                        <TextBlock Text="Size" VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <Slider x:Name="SizeSlider" Width="110" VerticalAlignment="Center" Focusable="False"
                                IsSnapToTickEnabled="True" TickFrequency="1" Minimum="1" Maximum="60"
                                ValueChanged="SizeSlider_ValueChanged"/>
                        <TextBlock x:Name="SizeValueText" Width="24" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <StackPanel x:Name="ShapeOptions" Orientation="Horizontal">
                        <CheckBox x:Name="FilledCheckBox" Content="Filled" Focusable="False" VerticalAlignment="Center"
                                  Margin="2,0,6,0" Checked="FilledCheckBox_Changed" Unchecked="FilledCheckBox_Changed"
                                  ToolTip="Fill the shape instead of drawing just its border"/>
                        <StackPanel x:Name="ColorPalette" Orientation="Horizontal">
                            <RadioButton x:Name="RedColorButton" Tag="#FF0000" ToolTip="Red"
                                         Style="{StaticResource ColorButtonStyle}" Checked="ColorButton_Checked">
                                <Rectangle Width="14" Height="14" Fill="#FF0000"/>
                            </RadioButton>
                            <RadioButton Tag="#0078D4" ToolTip="Blue"
                                         Style="{StaticResource ColorButtonStyle}" Checked="ColorButton_Checked">
                                <Rectangle Width="14" Height="14" Fill="#0078D4"/>
                            </RadioButton>
                            <RadioButton Tag="#00A000" ToolTip="Green"
                                         Style="{StaticResource ColorButtonStyle}" Checked="ColorButton_Checked">
                                <Rectangle Width="14" Height="14" Fill="#00A000"/>
                            </RadioButton>
                            <RadioButton Tag="#000000" ToolTip="Black"
                                         Style="{StaticResource ColorButtonStyle}" Checked="ColorButton_Checked">
                                <Rectangle Width="14" Height="14" Fill="#000000"/>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <Button Content="Undo" Style="{StaticResource ActionButtonStyle}" Click="UndoButton_Click" ToolTip="Ctrl+Z"/>
                    <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Click="CancelButton_Click" ToolTip="Esc"/>
                    <Button Content="Save" FontWeight="SemiBold" Style="{StaticResource ActionButtonStyle}"
                            Click="SaveButton_Click" ToolTip="Enter"/>
                </StackPanel>
                <DockPanel Margin="2,6,2,0">
                    <TextBlock DockPanel.Dock="Left" Text="Note" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="NoteTextBox" MaxLength="500" VerticalContentAlignment="Center" Padding="2"
                             ToolTip="Optional: what you did or observed. Saved with the screenshot in scenario.json."/>
                </DockPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
